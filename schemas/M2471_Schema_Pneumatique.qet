                    </label>
                </field>
                <field valign="center" row="0" name="project" hadjust="true" col="3" displaylabel="true" align="left">
                    <value>
                        <translation lang="fr">%projecttitle</translation>
                    </value>
                    <label>
                        <translation lang="fr">Projet</translation>
                    </label>
                </field>
                <field valign="center" row="1" name="MCT" hadjust="true" col="1" displaylabel="true" align="left" fontsize="9">
