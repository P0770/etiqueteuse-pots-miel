                <field valign="center" row="2" name="date" hadjust="true" col="1" displaylabel="true" align="left">
                    <value>
                        <translation lang="fr">%{versiondoc}</translation>
                    </value>
                    <label>
                        <translation lang="fr">Version</translation>
                    </label>
                </field>
                <field valign="center" row="2" name="file" hadjust="true" col="2" displaylabel="false" align="left" fontsize="9">
                    <value>
